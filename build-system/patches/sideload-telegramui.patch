+            maybeAppGroupUrl = sharedContainerUrl
+        } else {
+            // Free and ad-hoc sideload profiles generally cannot carry Telegram's
+            // App Group entitlement. Keep the main app usable in its own sandbox;
+            // the sideload package deliberately omits extensions that need sharing.
+            // Derive the data container from its writable temporary directory.
+            // NSHomeDirectory can resolve to a host path on headless Simulator
+            // runners when the simulated uid is absent from the password database.
+            let localContainerUrl = FileManager.default.temporaryDirectory
+                .deletingLastPathComponent()
+                .appendingPathComponent("Library/Application Support", isDirectory: true)
+            try? FileManager.default.createDirectory(at: localContainerUrl, withIntermediateDirectories: true)
+            maybeAppGroupUrl = localContainerUrl
+        }
