--- a/Sources/AppDelegate.swift
+++ b/Sources/AppDelegate.swift
@@ -318 +318,3 @@ private func extractAccountManagerState(records: AccountRecordsView<TelegramAcco
-        configuration.sharedContainerIdentifier = appGroupName
+        if FileManager.default.containerURL(forSecurityApplicationGroupIdentifier: appGroupName) != nil {
+            configuration.sharedContainerIdentifier = appGroupName
+        }
@@ -565 +567,35 @@ private func extractAccountManagerState(records: AccountRecordsView<TelegramAcco
-        let maybeAppGroupUrl = FileManager.default.containerURL(forSecurityApplicationGroupIdentifier: appGroupName)
+        let maybeAppGroupUrl: URL?
+        if let sharedContainerUrl = FileManager.default.containerURL(forSecurityApplicationGroupIdentifier: appGroupName) {
+            maybeAppGroupUrl = sharedContainerUrl
+        } else {
+            // Free and ad-hoc sideload profiles generally cannot carry Telegram's
+            // App Group entitlement. Keep the main app usable in its own sandbox;
+            // the sideload package deliberately omits extensions that need sharing.
+            let environment = ProcessInfo.processInfo.environment
+            var applicationSupportCandidates = [
+                environment["CFFIXED_USER_HOME"],
+                environment["HOME"],
+                NSHomeDirectory()
+            ].compactMap { value -> URL? in
+                guard let value, !value.isEmpty else {
+                    return nil
+                }
+                return URL(fileURLWithPath: value, isDirectory: true)
+                    .appendingPathComponent("Library/Application Support", isDirectory: true)
+            })
+            applicationSupportCandidates.append(contentsOf: FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask))
+            var writableContainerUrl: URL?
+            for applicationSupportUrl in applicationSupportCandidates {
+                let candidate = applicationSupportUrl.appendingPathComponent("AyuGram", isDirectory: true)
+                do {
+                    try FileManager.default.createDirectory(at: candidate, withIntermediateDirectories: true)
+                    let writeProbe = candidate.appendingPathComponent(".write-probe", isDirectory: false)
+                    try Data([0]).write(to: writeProbe, options: .atomic)
+                    try FileManager.default.removeItem(at: writeProbe)
+                    writableContainerUrl = candidate
+                    break
+                } catch {
+                }
+            }
+            maybeAppGroupUrl = writableContainerUrl
+        }
